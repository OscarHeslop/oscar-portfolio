---
import HomeLayout from '../layouts/HomeLayout.astro';
import ProjectPostComponent from '../components/ProjectPostComponent.astro';
import VibeCodedProjectComponent from '../components/VibeCodedProjectComponent.astro'
import '../style.css';
import '../font.css'
---
<div id="header">
  <div class="header-text">
    <h1>Oscar Heslop</h1>
    <h1>AI application engineer</h1>
  </div>
  <img id="profile_pic" src="images/profile.jpeg">
</div>
<HomeLayout> 
</HomeLayout>


<p>I enjoy learning new things and solving real world problems </p>
<p>Outside of coding I enjoy bouldering, cycling, running, swimming, calithenics and watching anime in my free time</p>



<h1>My Projects</h1>

<ProjectPostComponent
  title="Estate oppertunity tracker"
  link="/rightmove"
  about="A web scraper, collects data writes to Postgre Database.All stored locally."
  features={["Playwright","PostgreSQL","Flask"]}
  github = "https://github.com/OscarHeslop/estate-opportunity-tracker">
</ProjectPostComponent>


<ProjectPostComponent
  title="Auto website updater"
  link="/autoupdater"
  about="Lets user upload images and schedule when added to demo website,to increase Page Rank"
  features={["Sqlite","Scheduling","Flask"]}
  github = "https://github.com/OscarHeslop/website-update-scheduler">
</ProjectPostComponent>

---------------------------------------------------------------
<h1>Vibe coded Projects</h1>

<VibeCodedProjectComponent
  name="Computer Science Study App"
  about="An AI-assisted study app that taught me Firebase, Google sign-in, OpenRouter, and basic interaction with LLMs."
  link="https://oscarcompscistudyapp.netlify.app/">
</VibeCodedProjectComponent>

<VibeCodedProjectComponent
  name="Goals Planner"
  about="An AI-assisted goal planning application built to explore web application development and AI-assisted coding."
  link="https://oscargoalsplanner.netlify.app/">
</VibeCodedProjectComponent>
